      "id": "9e797540-f7c1-55f8-8e25-0827317c2c98",
      "name": "ParserBee: extract data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "ParserBee API key"
        }
      },
      "notes": "Paste your Parser Template ID into template_id. The API key comes from the 'ParserBee API key' Header Auth credential (name: x-api-key)."
    },
    {
      "parameters": {
        "jsCode": "// One row per line item, with the invoice fields repeated on each row.\n// Works with any Parser Template: the first list of objects in the result is\n// treated as the line items; every plain field becomes a column.\nconst sourceNames = $('New file in folder').all().map(f => f.json.name);\nconst rows = [];\n\n$input.all().forEach((item, i) => {\n  const data = item.json.data || {};\n  const header = { source_file: sourceNames[i] ?? '' };\n  let lines = [];\n  for (const [key, value] of Object.entries(data)) {\n    if (Array.isArray(value) && value.length && typeof value[0] === 'object') {\n      if (!lines.length) lines = value;\n    } else if (value === null || typeof value !== 'object') {\n      header[key] = value;\n    }\n  }\n  header.request_id = item.json.request_id;\n\n  if (!lines.length) {\n    rows.push({ json: header });\n    return;\n  }\n  for (const line of lines) {\n    const row = { ...header };\n    for (const [key, value] of Object.entries(line)) row[`line_${key}`] = value;\n    rows.push({ json: row });\n  }\n});\n\nreturn rows;\n"
      },
      "id": "76682d07-ea35-51c8-92c9-53ac38320da7",
      "name": "One row per line item",
